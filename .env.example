# =============================================================================
# LoyalMindApp — KoboToolbox local/production configuration
# =============================================================================
# This is the SINGLE SOURCE OF TRUTH for every variable used to configure and
# run the KoboToolbox stack (kobo-install + kobo-docker) in this project.
#
# Every value below is applied EVERY TIME you run `./scripts/kobo-start.sh`
# (which calls scripts/kobo_apply_env.py before `docker compose up`) - edit
# this file, then start/restart the stack, and the change takes effect. No
# flag to flip. Re-running with unchanged values is a cheap no-op.
#
# This file contains secrets (DB/admin passwords). It is gitignored — never
# commit it. Copy it to `.env.example` (with secrets blanked) if you need a
# shareable template.
# =============================================================================

# --- Docker Compose project name ---------------------------------------------
# Read by scripts/kobo_apply_env.py when it compiles docker-compose.yml (see
# that script's header comment: Compose's env-var-driven multi-file merge is
# unreliable with kobo-docker's YAML-anchored services, explicit -f flags
# are not - so we resolve the merge once into a static, generated file).
COMPOSE_PROJECT_NAME=loyalmind-kobo

# --- Installation paths ------------------------------------------------------
# Change KOBO_INSTALL_TYPE to "server" and fill KOBO_PUBLIC_DOMAIN_NAME with a
# real domain when deploying to the Ubuntu server (step 3 of the project plan).
KOBO_INSTALL_TYPE=workstation
KOBO_KOBODOCKER_PATH=./kobo-docker

# --- Domain / routing ---------------------------------------------------------
KOBO_PUBLIC_DOMAIN_NAME=kobo.local
KOBO_KPI_SUBDOMAIN=kf
KOBO_KC_SUBDOMAIN=kc
KOBO_EE_SUBDOMAIN=ee
KOBO_USE_HTTPS=false
KOBO_NGINX_PORT=80

# --- Let's Encrypt / HTTPS (production only) ---------------------------------
# Read directly by scripts/kobo_apply_env.py's ensure_letsencrypt() - not
# part of kobo-install's own config system (see scripts/compose-overrides.
# letsencrypt.yml's header comment for why: kobo-install's built-in
# use_letsencrypt support assumes a two-project frontend/backend layout this
# project doesn't use). Requires KOBO_USE_HTTPS=true and KOBO_INSTALL_TYPE=
# server, and the domain(s) must already resolve publicly to this server on
# ports 80/443 before this can succeed.
KOBO_USE_LETSENCRYPT=false
# Set true for the first deploy attempt (avoids burning Let's Encrypt's real
# rate limits while validating DNS/networking) - flip to false once a staging
# cert issues successfully, then re-run to get the real, browser-trusted one.
KOBO_LETSENCRYPT_STAGING=true
KOBO_LETSENCRYPT_EMAIL=changeme@example.org

# --- KoboToolbox super user (KPI admin login) --------------------------------
KOBO_SUPERUSER_USERNAME=super_admin
KOBO_SUPERUSER_PASSWORD=changeme-generate-a-real-secret

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=kobo
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_REPLICATION_PASSWORD=changeme-generate-a-real-secret
KPI_POSTGRES_DB=koboform
KC_POSTGRES_DB=kobocat
POSTGRES_PORT=5432

# --- MongoDB --------------------------------------------------------------
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme-generate-a-real-secret
MONGO_USER_USERNAME=kobo
MONGO_USER_PASSWORD=changeme-generate-a-real-secret
MONGO_PORT=27017

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=changeme-generate-a-real-secret
REDIS_MAIN_PORT=6379
REDIS_CACHE_PORT=6380

# --- Django / KPI secrets -----------------------------------------------------
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DJANGO_SESSION_COOKIE_AGE=604800

# --- Enketo (web form rendering) ---------------------------------------------
ENKETO_API_TOKEN=changeme-generate-a-real-secret
ENKETO_ENCRYPTION_KEY=changeme-generate-a-real-secret
ENKETO_LESS_SECURE_ENCRYPTION_KEY=changeme-generate-a-real-secret

# --- SMTP (email) --------------------------------------------------------
# Leave SMTP_HOST empty to send no real email (fine for local dev).
# Example below is Mailtrap's sandbox (safe testing inbox - no real email
# leaves Mailtrap). Swap in a real provider's values for production.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=changeme-generate-a-real-secret
SMTP_PASSWORD=changeme-generate-a-real-secret
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=support@kobo.local

# --- Backups (disabled by default; fill in and flip to true if needed) -------
KOBO_USE_BACKUP=false
